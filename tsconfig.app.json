{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "#build/ui": [
        "./node_modules/@nuxt/ui/.nuxt/ui"
      ],
      "@/*": [
        "resources/js/*"
      ]
    }
  },
  "include": [
    "resources/js/**/*.ts",
    "resources/js/**/*.vue",
    "resources/js/window.d.ts",
    "resources/js/vite-env.d.ts",
    "resources/js/auto-imports.d.ts",
    "resources/js/components.d.ts"
  ]
}
